# ==============================================================================
# Rapto Production Environment Variables & Secrets Reference
# ==============================================================================

# Core Runtime Settings
NODE_ENV=production
PORT=5000

# Docker & Registry Settings
DOCKER_REGISTRY=ghcr.io
IMAGE_NAME=rapto/api
IMAGE_TAG=latest

# Database Infrastructure Credentials
DATABASE_URL=postgresql://rapto_user:SECURE_DB_PASSWORD@postgres:5432/rapto_prod?schema=public&sslmode=prefer
DIRECT_URL=postgresql://rapto_user:SECURE_DB_PASSWORD@postgres:5432/rapto_prod?schema=public
MONGODB_URL=mongodb://root:SECURE_MONGO_PASSWORD@mongodb:27017/rapto?authSource=admin
REDIS_URL=redis://:SECURE_REDIS_PASSWORD@redis:6379

# Cryptographic & Session Secrets (Min 32 characters)
JWT_ACCESS_SECRET=generate_at_least_32_chars_random_string_for_access_jwt
JWT_REFRESH_SECRET=generate_at_least_32_chars_random_string_for_refresh_jwt

# Application Domain & URLs
APP_URL=https://app.rapto.cloud
FRONTEND_URL=https://app.rapto.cloud
API_URL=https://api.rapto.cloud

# Third-Party Integrations: OAuth & Webhooks
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://api.rapto.cloud/api/v1/auth/google/callback

JIRA_CLIENT_ID=your_jira_client_id
JIRA_CLIENT_SECRET=your_jira_client_secret
JIRA_CALLBACK_URL=https://api.rapto.cloud/api/v1/integrations/jira/callback
JIRA_WEBHOOK_SECRET=your_jira_webhook_signing_secret

SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret
SLACK_SIGNING_SECRET=your_slack_signing_secret
SLACK_CALLBACK_URL=https://api.rapto.cloud/api/v1/integrations/slack/callback

LINEAR_CLIENT_ID=your_linear_client_id
LINEAR_CLIENT_SECRET=your_linear_client_secret
LINEAR_CALLBACK_URL=https://api.rapto.cloud/api/v1/integrations/linear/callback

NOTION_CLIENT_ID=your_notion_client_id
NOTION_CLIENT_SECRET=your_notion_client_secret
NOTION_CALLBACK_URL=https://api.rapto.cloud/api/v1/integrations/notion/callback

OUTLOOK_CLIENT_ID=your_outlook_client_id
OUTLOOK_CLIENT_SECRET=your_outlook_client_secret
OUTLOOK_CALLBACK_URL=https://api.rapto.cloud/api/v1/integrations/outlook/callback
OUTLOOK_TENANT_ID=common

# Transactional Email (Brevo / Sendinblue)
BREVO_API_KEY=xkeysib-your_brevo_api_key
BREVO_FROM_EMAIL=notifications@rapto.cloud

# Payment Processor (Paddle Billing)
PADDLE_API_KEY=pdl_live_apikey_your_paddle_api_key
PADDLE_CLIENT_TOKEN=live_your_paddle_client_token
PADDLE_WEBHOOK_SECRET=pdl_ntfset_your_paddle_webhook_secret
PADDLE_ENVIRONMENT=production
PADDLE_PRICE_STARTER_M=pri_starter_monthly_id
PADDLE_PRICE_STARTER_Y=pri_starter_yearly_id
PADDLE_PRICE_GROWTH_M=pri_growth_monthly_id
PADDLE_PRICE_GROWTH_Y=pri_growth_yearly_id
PADDLE_PRICE_BUSINESS_M=pri_business_monthly_id
PADDLE_PRICE_BUSINESS_Y=pri_business_yearly_id

# Video Bot Integrations
RECALL_API_KEY=your_recall_ai_api_key
RECALL_WEBHOOK_SECRET=your_recall_ai_webhook_secret
RECALL_BASE_URL=https://ap-northeast-1.recall.ai/api/v1

# AI Processing Service
AI_PIPELINE_URL=http://ai-pipeline:8000
AI_PIPELINE_SECRET=change-me-min-32-chars-in-production-please-use-a-secure-secret
