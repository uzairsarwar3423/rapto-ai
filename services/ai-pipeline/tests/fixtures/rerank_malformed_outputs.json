{
  "_comment": "Grader outputs as the model might return them. n = number of candidates. Expected: either repaired (usable) or degraded to fused order. NONE may raise.",
  "cases": [
    {"name": "minor_duplicate", "n": 5, "ranking": [{"index": 0, "relevance": 3}, {"index": 1, "relevance": 2}, {"index": 0, "relevance": 1}, {"index": 2, "relevance": 1}],
     "expect": {"degraded": false, "repaired": true, "ordered": [0, 1, 2, 3, 4]}},
    {"name": "minor_out_of_range", "n": 4, "ranking": [{"index": 0, "relevance": 3}, {"index": 1, "relevance": 2}, {"index": 9, "relevance": 1}, {"index": 2, "relevance": 1}],
     "expect": {"degraded": false, "repaired": true, "ordered": [0, 1, 2, 3]}},
    {"name": "omitted_candidates_appended_in_fusion_order", "n": 4, "ranking": [{"index": 2, "relevance": 3}, {"index": 0, "relevance": 2}],
     "expect": {"degraded": false, "repaired": true, "ordered": [2, 0, 1, 3]}},
    {"name": "relevance_clamped", "n": 3, "ranking": [{"index": 0, "relevance": 7}, {"index": 1, "relevance": -2}, {"index": 2, "relevance": 1}],
     "expect": {"degraded": false, "repaired": true, "ordered": [0, 2], "grades": {"0": 3, "1": 0, "2": 1}}},
    {"name": "order_contradicts_grades", "n": 2, "ranking": [{"index": 0, "relevance": 1}, {"index": 1, "relevance": 3}],
     "expect": {"degraded": false, "repaired": true, "ordered": [1, 0]}},
    {"name": "clean", "n": 3, "ranking": [{"index": 1, "relevance": 3}, {"index": 0, "relevance": 2}, {"index": 2, "relevance": 0}],
     "expect": {"degraded": false, "repaired": false, "ordered": [1, 0]}},
    {"name": "mostly_invalid", "n": 3, "ranking": [{"index": 9, "relevance": 3}, {"index": 8, "relevance": 2}, {"index": 0, "relevance": 1}],
     "expect": {"degraded": true, "reason": "invalid_output", "ordered": [0, 1, 2]}},
    {"name": "empty_list", "n": 3, "ranking": [],
     "expect": {"degraded": true, "reason": "invalid_output", "ordered": [0, 1, 2]}},
    {"name": "all_duplicates_of_one", "n": 3, "ranking": [{"index": 1, "relevance": 3}, {"index": 1, "relevance": 3}, {"index": 1, "relevance": 3}],
     "expect": {"degraded": true, "reason": "invalid_output", "ordered": [0, 1, 2]}}
  ]
}
