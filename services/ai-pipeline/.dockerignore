# ==============================================================================
# Vocaply AI Pipeline — Docker Ignore Rules
# ==============================================================================

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd

# Virtual Environments
.venv/
venv/
env/
ENV/
.env/

# Distribution & Build Artifacts
dist/
build/
*.egg-info/
*.egg
*.whl

# Environment & Secret Files (NEVER bake secrets into image build context)
.env
.env.*
!.env.example

# Testing & Coverage Artifacts
.pytest_cache/
.coverage
htmlcov/
coverage.xml
.hypothesis/
test_*.txt
test_*.json
test_api_out*.txt

# Temporary / Debug Scripts
scratch*.py
fix_*.py
scratch-test.py
replace_script.py

# Documentation & Development Markdown Files
*.md
!pyproject.toml
!requirements.txt

# Type Check & Linter Caches
.mypy_cache/
.ruff_cache/
.flake8

# IDE & Editor Configuration
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/

# Operating System Files
.DS_Store
Thumbs.db
Desktop.ini

# Logs & Runtime State
*.log
logs/
*.pid

# Git Version Control
.git/
.gitignore
.github/
