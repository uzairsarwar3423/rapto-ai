# Required — must be set to real values
OPENAI_API_KEY=sk-proj-your-key-here
OPENAI_ORG_ID=
# Internal service auth — Node.js → Python shared secret
# Must be >= 32 chars in production. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
API_SHARED_SECRET=your-internal-shared-secret-min-32-chars

# Database connections
MONGODB_URL=mongodb://localhost:27017
REDIS_URL=redis://localhost:6379

# Optional — override defaults
ENVIRONMENT=development
LOG_LEVEL=INFO
PORT=8001

# Model names — change here to switch models without code deploy
OPENAI_GPT41_MINI_MODEL_NAME=gpt-4.1-mini
OPENAI_GPT41_MODEL_NAME=gpt-4.1
OPENAI_EMBEDDING_MODEL_NAME=text-embedding-3-small

# Resilience knobs
OPENAI_MAX_RETRIES=3
OPENAI_TIMEOUT_SECONDS=30.0
OPENAI_MAX_CONCURRENT_CALLS=10

# MongoDB pool sizing (pool_min_size × replica_count + pool_max_size × replica_count
# must stay under MongoDB Atlas / self-hosted connection ceiling)
MONGO_POOL_MIN_SIZE=2
MONGO_POOL_MAX_SIZE=20

# Redis pool sizing
REDIS_POOL_MAX_CONNECTIONS=20

# Node.js API origin for CORS scoping (non-production only)
NODE_API_INTERNAL_ORIGIN=http://localhost:5000

# MongoDB database name
MONGODB_DATABASE=vocaply

# ── AI client backend ─────────────────────────────────────────────────────────
# openai  = native OpenAI SDK (default)
# litellm = LiteLLM + instructor, with provider failover to Claude on 429/5xx
AI_CLIENT_BACKEND=openai

# ── Confidence Gate (low-confidence re-extraction) ───────────────────────────
# Chunks whose mean extraction confidence is below the threshold (or whose
# extractors returned only items below the item threshold, or failed) are
# re-extracted with a stronger model and merged.
CONFIDENCE_GATE_ENABLED=true
CONFIDENCE_GATE_THRESHOLD=0.60
CONFIDENCE_GATE_ITEM_THRESHOLD=0.55
CONFIDENCE_GATE_MIN_ITEMS=2
# openai    = re-extract with a stronger OpenAI model (default, no extra key)
# anthropic = re-extract with Claude (requires ANTHROPIC_API_KEY)
CONFIDENCE_GATE_FALLBACK_PROVIDER=openai
# Unset → OPENAI_GPT41_MODEL_NAME. Must differ from OPENAI_GPT41_MINI_MODEL_NAME.
# OPENAI_FALLBACK_MODEL_NAME=gpt-4.1
FALLBACK_MAX_CONCURRENT_CALLS=4

# ── Anthropic (only if CONFIDENCE_GATE_FALLBACK_PROVIDER=anthropic, or for
#    provider failover with AI_CLIENT_BACKEND=litellm) ─────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_CLAUDE_MODEL_NAME=claude-sonnet-5-5
ANTHROPIC_TIMEOUT_SECONDS=60

# ── LangSmith (prompt observability — optional) ───────────────────────────────
LANGSMITH_TRACING_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT_NAME=rapto-ai-pipeline
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
# PII guard: keep false unless transcripts may leave your infrastructure.
LANGSMITH_LOG_PAYLOADS=false

# ══ RAG infrastructure (Day 56) — opt-in; see docs/RAG_RUNBOOK.md ═════════════
RAG_ENABLED=false
# Runtime DSN: MUST be the NOBYPASSRLS role vocaply_ai_app (startup aborts otherwise).
# RAG_DATABASE_URL=postgresql://vocaply_ai_app:CHANGE_ME@host:5432/dbname
# Owner/admin DSN for `python -m src.rag.migrate` ONLY. Never used at runtime.
# RAG_ADMIN_DATABASE_URL=
# Read-only app-DB role for backfilling commitments/decisions/summaries.
# RAG_SOURCE_DATABASE_URL=
# true behind PgBouncer / Supavisor transaction pooling.
RAG_DB_POOLED=false
RAG_MONGO_DATABASE=rapto
EMBEDDING_BATCH_SIZE=100
EMBEDDING_BATCH_MAX_TOKENS=100000
EMBEDDING_CONCURRENCY=5
# Per PROCESS: (org TPM limit * 0.8) / replicas
EMBEDDING_TPM_BUDGET=800000
HNSW_EF_SEARCH=100
HNSW_ITERATIVE_SCAN=relaxed_order
SIMILARITY_TOP_K=20
RAG_WORKER_ENABLED=false

# ─── Chat backend (Day 58) ────────────────────────────────────────────────────
# Dark by default. Needs RAG_ENABLED=true and migration 004. See docs/chat/runbook_chat.md.
CHAT_ENABLED=false
CHAT_ENABLED_TEAM_IDS=            # CSV allow-list while the global flag is off (internal dogfooding)
CHAT_DISABLED_TEAM_IDS=           # CSV per-team kill switch (wins over everything)
CHAT_ACCESS_SCOPE_MODE=team_wide  # team_wide | attendee_only  (Q1: GA is blocked until decided)
CHAT_MONGO_DATABASE=rapto
CHAT_CURSOR_SECRET=               # falls back to API_SHARED_SECRET
# BFF-signed service JWT: JSON map kid -> PEM public key (several kids live during a rotation). Asymmetric algorithms only.
INTERNAL_JWT_PUBLIC_KEYS={}
INTERNAL_JWT_ALGORITHMS=RS256
INTERNAL_JWT_ISSUER=vocaply-bff
INTERNAL_JWT_AUDIENCE=vocaply-ai-chat
# Limits (defaults shown; per-plan variants: *_FREE / *_BUSINESS)
# CHAT_CTX_BUDGET=12000  CHAT_MAX_OUTPUT_TOKENS=700  CHAT_DAILY_LIMIT_PRO=200  CHAT_MONTHLY_USD_PRO=25
# CHAT_MAX_STREAMS_PER_USER=2  CHAT_GLOBAL_MAX_STREAMS=16  CHAT_RATE_LIMIT_PER_MIN=20
# CHAT_FAIL_OPEN_PAID_PLANS=true  (Q6: needs finance sign-off)
